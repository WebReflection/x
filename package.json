{
  "name": "@webreflection/x",
  "version": "0.2.15",
  "type": "module",
  "unpkg": "./x.js",
  "main": "./src/html.js",
  "module": "./src/html.js",
  "exports": {
    ".": "./x.js",
    "./attributes": "./src/handle/attr.js",
    "./fragment": "./src/classes/fragment.js",
    "./html": "./src/html.js",
    "./pony": "./src/pony.js",
    "./tag": "./src/tag.js",
    "./utils": "./src/utils.js"
  },
  "files": [
    "./src/",
    "LICENSE",
